APP_NAME="QrID"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# IMPORTANT : doit correspondre à l'URL réellement servie, sinon les liens
# des e-mails (confirmation d'inscription) pointent au mauvais endroit.
APP_URL=http://127.0.0.1:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=identite_pro
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# File d'attente : les e-mails sont envoyés par un worker, hors de la requête.
QUEUE_CONNECTION=database

# En dev, « file » évite des dizaines de requêtes SQL dues au rate limiting.
# En production, préférer « redis ».
CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# E-MAIL — DÉVELOPPEMENT (Gmail SMTP)
# MAIL_PASSWORD = mot de passe d'application Google (16 caractères), sans espaces.
# MAIL_FROM_ADDRESS doit être IDENTIQUE à MAIL_USERNAME (Gmail réécrit sinon).
# Port 587 bloqué par le FAI ou l'antivirus ? Basculer sur 465 + ssl.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre-adresse@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=votre-adresse@gmail.com
MAIL_FROM_NAME="QrID"

# Alerte informative si plus de N envois dans la même heure (jamais bloquant).
# Aucun filtrage de destinataire n'existe dans le projet.
MAIL_HOURLY_ALERT=100

# ---------------------------------------------------------------------------
# E-MAIL — PRODUCTION (Resend, par HTTPS)
#
# POURQUOI PAS SMTP EN PRODUCTION : la connexion sortante vers un serveur SMTP
# n'aboutit pas de façon fiable depuis un conteneur Render. Resend envoie par
# une requête HTTPS ordinaire sur le port 443 — aucun port exotique, et une
# erreur d'API explicite là où un échec SMTP se résume à un délai dépassé.
#
# SANS DOMAINE : onboarding@resend.dev fonctionne immédiatement, mais Resend
# n'autorise alors l'envoi QU'À l'adresse du titulaire du compte. Suffisant
# pour vérifier la chaîne, insuffisant pour de vrais clients.
#
# AVEC LE DOMAINE : le vérifier chez Resend (SPF + DKIM), puis remplacer
# MAIL_FROM_ADDRESS. Aucune ligne de code ne change.
# ---------------------------------------------------------------------------
# MAIL_MAILER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxx
# MAIL_FROM_ADDRESS=onboarding@resend.dev
# MAIL_FROM_NAME="QrID"
# APP_ENV=production

# ---------------------------------------------------------------------------
# Inscription (double opt-in)
# ---------------------------------------------------------------------------
REGISTRATION_VERIFICATION_TTL=60
REGISTRATION_MAX_RESENDS=3
REGISTRATION_RESEND_COOLDOWN=60
REGISTRATION_RATE_PER_IP=5
REGISTRATION_RATE_PER_EMAIL=3

# Support affiché sur la page de confirmation.
SUPPORT_WHATSAPP_URL=https://wa.me/221770000000

# ---------------------------------------------------------------------------
# MARQUE IMPRIMÉE AU VERSO DES CARTES
# Ces valeurs partent chez l'imprimeur en centaines d'exemplaires : elles ne
# se corrigent pas par un déploiement. BRAND_WEBSITE est volontairement
# distinct d'APP_URL — l'application peut tourner sur app.exemple.sn alors que
# la carte doit porter le site vitrine.
# ---------------------------------------------------------------------------
BRAND_WEBSITE=qrid.sn
BRAND_TAGLINE="Votre identité professionnelle, en un scan"

# Destinataire des alertes techniques (file bloquée, job en échec).
ADMIN_ALERT_EMAIL=

# ---------------------------------------------------------------------------
# ALERTES D'ÉQUIPE (bloc 1 du plan de lancement)
#
# ADMIN_ALERT_RECIPIENTS — liste explicite, séparée par des virgules. LAISSER
# VIDE est le réglage recommandé : les alertes partent alors vers TOUS les
# comptes de rôle « admin » présents en base, et ajouter un administrateur
# suffit à l'abonner. Une liste figée se périme au premier changement
# d'équipe, et les alertes de celui qui part disparaissent sans bruit.
#
# À ne renseigner que pour viser une boîte partagée (support@) plutôt que
# trois boîtes personnelles.
# ---------------------------------------------------------------------------
ADMIN_ALERT_RECIPIENTS=

# Interrupteurs des alertes de CONFORT. Sur un produit qui marche, « nouveau
# client inscrit » finit par arriver vingt fois par jour.
# Les alertes d'ÉCHEC — paiement refusé, traitement tombé — ne figurent pas
# ici : elles ne sont pas désactivables, par construction.
ALERT_ON_SIGNUP=true
ALERT_ON_PROFILE=true
ALERT_ON_PUBLISH=true
ALERT_ON_PAYMENT=true

# ---------------------------------------------------------------------------
# COMPTE ADMINISTRATEUR — lu par AdminSeeder (config/registration.php).
# Sans ces valeurs, « php artisan migrate --seed » ne crée aucun accès
# d'administration et /admin reste inaccessible.
# Le mot de passe est à changer dès la première connexion en production.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Administrateur"
ADMIN_PHONE=

VITE_APP_NAME="${APP_NAME}"
